FROM golang:alpine

# Install git and bash for dependencies and script execution
RUN apk update && apk add --no-cache git bash

WORKDIR /app

# Copy dependency files first for caching
COPY go.mod go.sum ./

RUN go mod download 

# Copy the source from the current directory to the working Directory inside the container 
COPY . .

# Move into the tests directory so relative path lookups (like ../../.env) work correctly
WORKDIR /app/tests

# Run tests sequentially (-p=1) to prevent parallel database schema collisions
CMD ["go", "test", "-v", "-p=1", "./..."]
